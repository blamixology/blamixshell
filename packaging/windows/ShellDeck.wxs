<?xml version="1.0" encoding="utf-8"?>
<!--
  ShellDeck Windows installer (WiX Toolset v5).

  Dual-purpose package: the installer ASKS whether to install
    • for all users  -> C:\Program Files\ShellDeck           (needs admin)
    • just for me    -> %LOCALAPPDATA%\Programs\ShellDeck    (no admin)
  Silent installs:
    msiexec /i ShellDeck.msi /qn ALLUSERS=1                        (all users)
    msiexec /i ShellDeck.msi /qn ALLUSERS=2 MSIINSTALLPERUSER=1    (current user)

  Build: see packaging/windows/build_msi.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="ShellDeck"
           Manufacturer="ShellDeck contributors"
           Version="$(var.Version)"
           UpgradeCode="e3f36baf-2b0c-4135-a5f5-530a0d60532a"
           Scope="perUserOrMachine"
           Compressed="yes"
           Language="1033">

    <SummaryInformation Description="ShellDeck SSH client" />
    <!-- Upgrades remove the old version first, inside the same transaction
         (if the new install fails, the old version is rolled back in place). -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of ShellDeck is already installed." />

    <!-- Files of a running ShellDeck (and its Chromium helper processes) can't be replaced:
         ask them to close, and end them if they don't within a few seconds. -->
    <util:CloseApplication Id="CloseShellDeck" Target="ShellDeck.exe"
                           CloseMessage="yes" TerminateProcess="1" Timeout="5" RebootPrompt="no" />
    <util:CloseApplication Id="CloseWebEngine" Target="QtWebEngineProcess.exe"
                           TerminateProcess="1" Timeout="2" RebootPrompt="no" />
    <!-- one embedded cabinet (default splits every 200 MB; Qt WebEngine makes several) -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="1800" />

    <!-- Apps & features entry -->
    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/blamixology/shelldeck" />
    <Property Id="ARPHELPLINK" Value="https://github.com/blamixology/shelldeck/issues" />

    <!-- WixUI_Advanced = welcome/license -> "Install for all users / just for me" -> folder -> features -->
    <Property Id="ApplicationFolderName" Value="ShellDeck" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Advanced" />
    <!-- WixUI_Advanced defaults to the 32-bit Program Files and %LOCALAPPDATA%\Apps.
         Point it at the 64-bit Program Files and the standard per-user %LOCALAPPDATA%\Programs,
         for interactive AND silent installs (Sequence="both"). -->
    <SetProperty Id="WixPerMachineFolder" Value="[ProgramFiles64Folder][ApplicationFolderName]"
                 After="WixSetDefaultPerMachineFolder" Sequence="both" />
    <SetProperty Id="WixPerUserFolder" Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]"
                 After="WixSetDefaultPerUserFolder" Sequence="both" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="ShellDeck" />
    </StandardDirectory>

    <Feature Id="Main" Title="ShellDeck" Description="The ShellDeck application."
             Level="1" AllowAbsent="no" Display="expand">
      <!-- the whole PyInstaller output folder (includes installed.marker) -->
      <Files Directory="APPLICATIONFOLDER" Include="$(var.SourceDir)\**" />

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="6f0c7a0e-2d61-4a55-9a0d-3c1f5c0b7a11">
        <Shortcut Id="StartMenuSc" Name="ShellDeck" Description="SSH client with server manager, splits and SFTP"
                  Target="[APPLICATIONFOLDER]ShellDeck.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\ShellDeck" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Description="Add a ShellDeck icon to the desktop." Level="1">
      <Component Id="DesktopShortcutComp" Directory="DesktopFolder" Guid="b8a5d1c2-4e3f-4f1a-9c62-7d8e9f0a1b22">
        <Shortcut Id="DesktopSc" Name="ShellDeck" Target="[APPLICATIONFOLDER]ShellDeck.exe"
                  WorkingDirectory="APPLICATIONFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\ShellDeck" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
