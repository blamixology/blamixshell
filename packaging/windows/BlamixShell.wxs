<?xml version="1.0" encoding="utf-8"?>
<!--
  BlamixShell Windows installer (WiX Toolset v5).

  Dual-purpose package: the installer ASKS whether to install
    • for all users  -> C:\Program Files\BlamixShell           (needs admin)
    • just for me    -> %LOCALAPPDATA%\Programs\BlamixShell    (no admin)
  Silent installs:
    msiexec /i BlamixShell.msi /qn ALLUSERS=1                        (all users)
    msiexec /i BlamixShell.msi /qn ALLUSERS=2 MSIINSTALLPERUSER=1    (current user)

  Build: see packaging/windows/build_msi.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- UpgradeCode is unchanged since "ShellDeck" 1.x, so this package upgrades those installs. -->
  <Package Name="BlamixShell"
           Manufacturer="BlamixShell contributors"
           Version="$(var.Version)"
           UpgradeCode="e3f36baf-2b0c-4135-a5f5-530a0d60532a"
           Scope="perUserOrMachine"
           Compressed="yes"
           Language="1033">

    <SummaryInformation Description="BlamixShell SSH client" />
    <!-- Upgrades remove the old version first, inside the same transaction
         (if the new install fails, the old version is rolled back in place). -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of BlamixShell is already installed." />

    <!-- An "all users" and a "just for me" copy can't upgrade each other (Windows keeps
         the two contexts apart), so installing over the other kind would leave two copies
         or fail half-way (error 2349/1603). Detect the other copy and stop with a clear
         message instead. HKMU values below land in HKLM (all users) or HKCU (just me). -->
    <Property Id="SD_MACHINE_COPY" Secure="yes">
      <RegistrySearch Id="FindMachineCopy" Root="HKLM" Key="Software\BlamixShell"
                      Name="StartMenuShortcut" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="SD_USER_COPY" Secure="yes">
      <RegistrySearch Id="FindUserCopy" Root="HKCU" Key="Software\BlamixShell"
                      Name="StartMenuShortcut" Type="raw" />
    </Property>
    <!-- the same, for installs from before the rename (ShellDeck 1.x) -->
    <Property Id="SD_MACHINE_COPY_OLD" Secure="yes">
      <RegistrySearch Id="FindMachineCopyOld" Root="HKLM" Key="Software\ShellDeck"
                      Name="StartMenuShortcut" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="SD_USER_COPY_OLD" Secure="yes">
      <RegistrySearch Id="FindUserCopyOld" Root="HKCU" Key="Software\ShellDeck"
                      Name="StartMenuShortcut" Type="raw" />
    </Property>
    <CustomAction Id="BlockOverMachineCopy"
                  Error="BlamixShell is already installed for all users (in Program Files). Choose &quot;Install for all users&quot; to upgrade it, or uninstall it first from Settings &gt; Apps." />
    <CustomAction Id="BlockOverUserCopy"
                  Error="BlamixShell is already installed just for your account (in AppData). Choose &quot;Install just for you&quot; to upgrade it, or uninstall it first from Settings &gt; Apps." />
    <InstallExecuteSequence>
      <!-- runs before any file is touched; the install scope is final by now -->
      <Custom Action="BlockOverMachineCopy" After="AppSearch"
              Condition="(SD_MACHINE_COPY OR SD_MACHINE_COPY_OLD) AND NOT Installed AND ((ALLUSERS=2 AND MSIINSTALLPERUSER=1) OR NOT ALLUSERS)" />
      <Custom Action="BlockOverUserCopy" After="BlockOverMachineCopy"
              Condition="(SD_USER_COPY OR SD_USER_COPY_OLD) AND NOT Installed AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER=1))" />
    </InstallExecuteSequence>

    <!-- Files of a running BlamixShell (and its Chromium helper processes) can't be replaced:
         ask them to close, and end them if they don't within a few seconds. -->
    <util:CloseApplication Id="CloseBlamixShell" Target="BlamixShell.exe"
                           CloseMessage="yes" TerminateProcess="1" Timeout="5" RebootPrompt="no" />
    <util:CloseApplication Id="CloseShellDeckOld" Target="ShellDeck.exe"
                           CloseMessage="yes" TerminateProcess="1" Timeout="5" RebootPrompt="no" />
    <util:CloseApplication Id="CloseWebEngine" Target="QtWebEngineProcess.exe"
                           TerminateProcess="1" Timeout="2" RebootPrompt="no" />
    <!-- one embedded cabinet (default splits every 200 MB; Qt WebEngine makes several) -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="1800" />

    <!-- Apps & features entry -->
    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/blamixology/blamixshell" />
    <Property Id="ARPHELPLINK" Value="https://github.com/blamixology/blamixshell/issues" />

    <!-- WixUI_Advanced = welcome/license -> "Install for all users / just for me" -> folder -> features -->
    <Property Id="ApplicationFolderName" Value="BlamixShell" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Advanced" />
    <!-- WixUI_Advanced defaults to the 32-bit Program Files and %LOCALAPPDATA%\Apps.
         Point it at the 64-bit Program Files and the standard per-user %LOCALAPPDATA%\Programs,
         for interactive AND silent installs (Sequence="both"). -->
    <SetProperty Id="WixPerMachineFolder" Value="[ProgramFiles64Folder][ApplicationFolderName]"
                 After="WixSetDefaultPerMachineFolder" Sequence="both" />
    <SetProperty Id="WixPerUserFolder" Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]"
                 After="WixSetDefaultPerUserFolder" Sequence="both" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="BlamixShell" />
    </StandardDirectory>

    <Feature Id="Main" Title="BlamixShell" Description="The BlamixShell application."
             Level="1" AllowAbsent="no" Display="expand">
      <!-- the whole PyInstaller output folder (includes installed.marker) -->
      <Files Directory="APPLICATIONFOLDER" Include="$(var.SourceDir)\**" />

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="49064366-d290-4350-a259-71932c996888">
        <Shortcut Id="StartMenuSc" Name="BlamixShell" Description="SSH client with server manager, splits and SFTP"
                  Target="[APPLICATIONFOLDER]BlamixShell.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\BlamixShell" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Description="Add a BlamixShell icon to the desktop." Level="1">
      <Component Id="DesktopShortcutComp" Directory="DesktopFolder" Guid="5f7c2e3f-dbe5-43bd-931f-b71cbfbb4d73">
        <Shortcut Id="DesktopSc" Name="BlamixShell" Target="[APPLICATIONFOLDER]BlamixShell.exe"
                  WorkingDirectory="APPLICATIONFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\BlamixShell" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
